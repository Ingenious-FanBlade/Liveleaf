{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liveleaf",
  "version": "0.1.0",
  "identifier": "io.github.amiya114514.liveleaf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liveleaf",
        "width": 800,
        "height": 600,
        "decorations": false,
        "shadow": false,
        "resizable": true,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../docs/syntax-reference.md": "docs/syntax-reference.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
